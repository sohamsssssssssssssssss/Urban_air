# All keys are server-side only. Never prefix with NEXT_PUBLIC_. Put real values in .env.local (gitignored).
# OpenAQ v3 key: sign in at https://explore.openaq.org and copy it from Account Settings
OPENAQ_API_KEY=
# data.gov.in key (CPCB real-time AQI fallback): https://data.gov.in -> My Account -> API key
DATA_GOV_IN_API_KEY=
# Gemini key (optional; rule-based advice works without it): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default: gemini-2.5-flash-lite
GEMINI_MODEL=
